@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:noppadol:assets:scheme> a skos:ConceptScheme ; skos:prefLabel "My Assets"@en .

<urn:noppadol:assets:concept:asset> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "ทรัพย์สินที่จัดการ"@th ;
 skos:prefLabel "Managed asset"@en ;
 skos:definition "สิ่งหรือสิทธิที่นำเข้าทะเบียนเพื่อดูแล ใช้งาน หรือศึกษา"@th ;
 skos:scopeNote "การมีรายการไม่ยืนยันกรรมสิทธิ์"@th .

<urn:noppadol:assets:concept:physical-item> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "วัตถุรายชิ้น"@th ;
 skos:prefLabel "Physical item"@en ;
 skos:definition "วัตถุที่แยกตัวตนและติดตามเป็นรายชิ้นได้"@th ;
 skos:scopeNote "ชนิดสินค้าและชื่อรุ่นไม่ใช่ตัววัตถุ"@th .

<urn:noppadol:assets:concept:product-model> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "รุ่นผลิตภัณฑ์"@th ;
 skos:prefLabel "Product model"@en ;
 skos:altLabel "รุ่นสินค้า"@th ;
 skos:definition "แบบหรือรุ่นที่ผู้ผลิตใช้จำแนกผลิตภัณฑ์"@th ;
 skos:scopeNote "หลายชิ้นอาจมีรุ่นเดียวกัน"@th .

<urn:noppadol:assets:concept:collection> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "คอลเลกชันทรัพย์สิน"@th ;
 skos:prefLabel "Asset collection"@en ;
 skos:definition "ชุดทรัพย์สินที่รวบรวมด้วยวัตถุประสงค์ร่วมกัน"@th ;
 skos:scopeNote "ไม่ใช้แทนสมาชิกแต่ละชิ้น"@th .

<urn:noppadol:assets:concept:woodworking-tool> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "เครื่องมืองานไม้"@th ;
 skos:prefLabel "Woodworking tool"@en ;
 skos:altLabel "เครื่องมือช่างไม้"@th ;
 skos:definition "อุปกรณ์ที่ใช้ทำงานกับไม้ตามหน้าที่ของเครื่องมือ"@th ;
 skos:scopeNote "งานไม้เป็นกิจกรรม ใช้แนวคิดเดิม"@th .

<urn:noppadol:assets:concept:hand-plane> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "กบไสไม้"@th ;
 skos:prefLabel "Hand plane"@en ;
 skos:altLabel "กบไสไม้มือ"@th ;
 skos:altLabel "handplane"@en ;
 skos:definition "เครื่องมือไสไม้ที่ใช้แรงมือขับใบตัดเพื่อตกแต่งผิวหรือรูปทรง"@th ;
 skos:scopeNote "ไม่รวมกบไฟฟ้า; คำว่า กบ เดี่ยวกำกวม"@th .

<urn:noppadol:assets:concept:chisel> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "สิ่ว"@th ;
 skos:prefLabel "Chisel"@en ;
 skos:definition "เครื่องมือใบตัดสำหรับสกัดหรือแต่งวัสดุ ในรุ่นนี้เน้นการใช้งานกับไม้"@th ;
 skos:scopeNote "ไม่ระบุว่าสิ่วทุกชนิดใช้ค้อนได้"@th .

<urn:noppadol:assets:concept:saw> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "เลื่อย"@th ;
 skos:prefLabel "Saw"@en ;
 skos:definition "เครื่องมือที่ใช้ฟันตัดแบ่งหรือแต่งวัสดุ"@th ;
 skos:scopeNote "ยังไม่แยกแรงมือและกำลังไฟฟ้า"@th .

<urn:noppadol:assets:concept:sharpening-stone> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "หินลับคม"@th ;
 skos:prefLabel "Sharpening stone"@en ;
 skos:altLabel "หินลับคมเครื่องมือ"@th ;
 skos:definition "วัสดุลักษณะก้อนหรือแผ่นที่ใช้ขัดเพื่อสร้างหรือรักษาคมเครื่องมือ"@th ;
 skos:scopeNote "ไม่รวมอุปกรณ์ลับคมทุกประเภท"@th .

<urn:noppadol:assets:concept:camera> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "กล้องถ่ายรูป"@th ;
 skos:prefLabel "Camera"@en ;
 skos:altLabel "กล้องถ่ายภาพ"@th ;
 skos:definition "อุปกรณ์บันทึกภาพนิ่งซึ่งบางรุ่นบันทึกวิดีโอได้"@th ;
 skos:scopeNote "คำว่า กล้อง ต้องดูบริบท ไม่รวมข้าวกล้อง"@th .

<urn:noppadol:assets:concept:lens> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "เลนส์ถ่ายภาพ"@th ;
 skos:prefLabel "Photographic lens"@en ;
 skos:definition "ชุดอุปกรณ์ทางแสงสำหรับสร้างภาพในการถ่ายภาพ"@th ;
 skos:scopeNote "ไม่รวมเลนส์แว่นตา"@th .

<urn:noppadol:assets:concept:record-disc> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "แผ่นเสียง"@th ;
 skos:prefLabel "Phonograph record"@en ;
 skos:altLabel "phonograph disc"@en ;
 skos:definition "สื่อรูปแผ่นที่เก็บเสียงด้วยร่องสำหรับเล่นกลับ"@th ;
 skos:scopeNote "ไม่สมมติว่าทุกแผ่นทำจากไวนิล; แยกจากบทเพลงและไฟล์เสียง"@th .

<urn:noppadol:assets:concept:turntable> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "เครื่องเล่นแผ่นเสียง"@th ;
 skos:prefLabel "Record player"@en ;
 skos:definition "อุปกรณ์อ่านร่องแผ่นเสียงเพื่อเล่นเสียง"@th ;
 skos:scopeNote "แยกตัวเครื่องออกจากแผ่นเสียง"@th .

<urn:noppadol:assets:concept:musical-work> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "ผลงานดนตรี"@th ;
 skos:prefLabel "Musical work"@en ;
 skos:definition "ตัวงานประพันธ์หรือบทเพลงที่อาจมีการบันทึกหลายครั้ง"@th ;
 skos:scopeNote "ไม่เท่ากับการบันทึกหนึ่งครั้งหรือแผ่นหนึ่งแผ่น"@th .

<urn:noppadol:assets:concept:sound-recording> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "สิ่งบันทึกเสียง"@th ;
 skos:prefLabel "Sound recording"@en ;
 skos:definition "เนื้อหาเสียงจากการบันทึกที่ระบุได้"@th ;
 skos:scopeNote "ไม่ใช่กิจกรรมการบันทึกเสียงหรือไฟล์สำเนาโดยอัตโนมัติ"@th .

<urn:noppadol:assets:concept:release-edition> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "ฉบับเผยแพร่"@th ;
 skos:prefLabel "Release edition"@en ;
 skos:definition "ฉบับที่เผยแพร่ของงานหรือสิ่งบันทึก เช่นฉบับแผ่นเสียง"@th ;
 skos:scopeNote "แยกจากแผ่นรายชิ้นและผลงานต้นทาง"@th .

<urn:noppadol:assets:concept:investment-fund> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "กองทุนเพื่อการลงทุน"@th ;
 skos:prefLabel "Investment fund"@en ;
 skos:definition "กองทุนที่ใช้เป็นผลิตภัณฑ์สำหรับการลงทุนในขอบเขตทะเบียนนี้"@th ;
 skos:scopeNote "กองทุนช่วยเหลือและคำว่า กองทุน เดี่ยวต้องตรวจบริบท"@th .

<urn:noppadol:assets:concept:fund-unit> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "หน่วยลงทุน"@th ;
 skos:prefLabel "Fund unit"@en ;
 skos:definition "หน่วยที่ใช้ระบุส่วนการลงทุนในกองทุนที่ออกหน่วย"@th ;
 skos:scopeNote "แยกจากจำนวนหน่วยที่เจ้าของถือ ณ วันใด"@th .

<urn:noppadol:assets:concept:cryptoasset> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "สินทรัพย์คริปโต"@th ;
 skos:prefLabel "Cryptoasset"@en ;
 skos:altLabel "คริปโต"@th ;
 skos:altLabel "crypto"@en ;
 skos:hiddenLabel "Crtpto"@en ;
 skos:definition "สินทรัพย์หรือหน่วยดิจิทัลที่อาศัยระบบเข้ารหัสและบัญชีรายการแบบกระจายตามบริบทที่บันทึก"@th ;
 skos:scopeNote "นิยามใช้งาน ไม่ตัดสินสถานะทางกฎหมาย; ไม่รวมไฟล์ดิจิทัลทั่วไป"@th .

<urn:noppadol:assets:concept:holding> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "สถานะการถือครอง"@th ;
 skos:prefLabel "Holding"@en ;
 skos:definition "รายการที่ระบุผู้ถือ สิ่งที่ถือ จำนวน หน่วย และเวลาอ้างอิง"@th ;
 skos:scopeNote "ไม่เท่ากับชนิดสินทรัพย์หรือรายการซื้อขาย"@th .

<urn:noppadol:assets:concept:transaction> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "ธุรกรรมทรัพย์สิน"@th ;
 skos:prefLabel "Asset transaction"@en ;
 skos:definition "เหตุการณ์ได้มา โอน หรือจำหน่ายทรัพย์สินที่มีวันและหลักฐาน"@th ;
 skos:scopeNote "ไม่ใช้แทนยอดคงเหลือ"@th .

<urn:noppadol:assets:concept:valuation> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "การประเมินมูลค่า"@th ;
 skos:prefLabel "Valuation"@en ;
 skos:definition "ค่าประเมินของสิ่งที่ระบุ พร้อมเวลา สกุลเงิน แหล่ง และวิธี"@th ;
 skos:scopeNote "ไม่ใช้ราคาครั้งเดียวแทนมูลค่าปัจจุบันตลอดไป"@th .

<urn:noppadol:assets:concept:ownership> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "กรรมสิทธิ์"@th ;
 skos:prefLabel "Ownership"@en ;
 skos:definition "ความสัมพันธ์การเป็นเจ้าของตามข้อมูลและหลักฐานที่บันทึก"@th ;
 skos:scopeNote "ไม่เท่ากับการยืม ครอบครองทางกายภาพ หรือกล่าวถึง"@th .

<urn:noppadol:assets:concept:custody> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "การเก็บรักษาทรัพย์สิน"@th ;
 skos:prefLabel "Asset custody"@en ;
 skos:definition "ความสัมพันธ์ว่าใครหรือที่ใดดูแลทรัพย์สินในช่วงหนึ่ง"@th ;
 skos:scopeNote "ไม่อนุมานกรรมสิทธิ์จากการเก็บรักษา"@th .

<urn:noppadol:assets:concept:condition> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "สภาพทรัพย์สิน"@th ;
 skos:prefLabel "Asset condition"@en ;
 skos:definition "สภาพของทรัพย์สินตามการสังเกต ณ เวลาหนึ่ง"@th ;
 skos:scopeNote "ไม่ใช่ระดับคุณภาพถาวรของรุ่นผลิตภัณฑ์"@th .

<urn:noppadol:assets:concept:maintenance> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "การบำรุงรักษา"@th ;
 skos:prefLabel "Maintenance"@en ;
 skos:altLabel "การดูแลบำรุงรักษา"@th ;
 skos:definition "การดูแลเพื่อรักษาหรือฟื้นความพร้อมใช้งาน"@th ;
 skos:scopeNote "ไม่ใช่ข้อยืนยันว่าได้ดำเนินการแล้ว"@th .

<urn:noppadol:assets:concept:sharpening> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "การลับคม"@th ;
 skos:prefLabel "Sharpening"@en ;
 skos:altLabel "ลับคมเครื่องมือ"@th ;
 skos:definition "การแต่งคมเครื่องมือให้เหมาะกับการใช้งาน"@th ;
 skos:scopeNote "แยกจากหินลับคมที่เป็นอุปกรณ์"@th .

<urn:noppadol:assets:concept:repair> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "การซ่อม"@th ;
 skos:prefLabel "Repair"@en ;
 skos:altLabel "การซ่อมแซม"@th ;
 skos:definition "การแก้ความชำรุดของทรัพย์สิน"@th ;
 skos:scopeNote "แยกจากการปรับแต่งที่ไม่ได้แก้ความชำรุด"@th .

<urn:noppadol:assets:concept:use-session> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "กิจกรรมใช้ทรัพย์สิน"@th ;
 skos:prefLabel "Asset use session"@en ;
 skos:definition "เหตุการณ์ทดลองหรือใช้ทรัพย์สินเพื่อทำงานหรือเรียนรู้"@th ;
 skos:scopeNote "การมีเครื่องมือไม่ยืนยันว่าเคยใช้งาน"@th .

<urn:noppadol:assets:concept:observation> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "บันทึกการสังเกตทรัพย์สิน"@th ;
 skos:prefLabel "Asset observation"@en ;
 skos:definition "บันทึกสิ่งที่พบจากการใช้ ตรวจ หรือศึกษา พร้อมผู้บันทึกและเวลา"@th ;
 skos:scopeNote "ไม่เท่ากับข้อเท็จจริงสากลหรือ MetadataObservation ของไฟล์"@th .

<urn:noppadol:assets:concept:capability> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "ความสามารถในการใช้งาน"@th ;
 skos:prefLabel "Asset capability"@en ;
 skos:definition "หน้าที่หรือผลที่ทรัพย์สินรองรับภายใต้เงื่อนไขที่ระบุ"@th ;
 skos:scopeNote "ไม่รับรองผลสำเร็จของผู้ใช้"@th .

<urn:noppadol:assets:concept:material> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "วัสดุของทรัพย์สิน"@th ;
 skos:prefLabel "Asset material"@en ;
 skos:definition "วัสดุที่ประกอบเป็นทรัพย์สินหรือชิ้นส่วนตามข้อมูลที่มี"@th ;
 skos:scopeNote "วัสดุของใบสิ่วอาจต่างจากวัสดุของด้าม"@th .

<urn:noppadol:assets:concept:technique> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "เทคนิคการใช้งาน"@th ;
 skos:prefLabel "Use technique"@en ;
 skos:definition "วิธีใช้หรือดูแลทรัพย์สินที่บันทึกเป็นความรู้ได้"@th ;
 skos:scopeNote "ไม่ใช่ตัวเครื่องมือหรือเหตุการณ์ใช้ครั้งหนึ่ง"@th .

<urn:noppadol:assets:concept:manual> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "คู่มือทรัพย์สิน"@th ;
 skos:prefLabel "Asset manual"@en ;
 skos:definition "เอกสารแนะนำการใช้และดูแลทรัพย์สินหรือรุ่น"@th ;
 skos:scopeNote "คู่มือเป็น KnowledgeInput ไม่ใช่เครื่องมือเอง"@th .

<urn:noppadol:assets:concept:acquisition-record> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "บันทึกการได้มา"@th ;
 skos:prefLabel "Acquisition record"@en ;
 skos:altLabel "บันทึกการได้ทรัพย์สินมา"@th ;
 skos:definition "เอกสารหรือบันทึกแหล่งที่มาและเหตุการณ์ได้ทรัพย์สิน"@th ;
 skos:scopeNote "การมีใบเสร็จไม่ได้ยืนยันสถานะเจ้าของปัจจุบัน"@th .

<urn:noppadol:assets:concept:content-rights> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "สิทธิในการใช้เนื้อหา"@th ;
 skos:prefLabel "Content usage rights"@en ;
 skos:altLabel "สิทธิการใช้เนื้อหา"@th ;
 skos:definition "สิทธิและเงื่อนไขในการนำเนื้อหาจากทรัพย์สินหรือเอกสารไปใช้"@th ;
 skos:scopeNote "การเป็นเจ้าของแผ่นเสียงไม่เท่ากับได้สิทธิเผยแพร่เพลง"@th .

<urn:noppadol:assets:concept:bench-plane> a skos:Concept ;
 skos:inScheme <urn:noppadol:assets:scheme> ;
 skos:prefLabel "กบงานพื้นฐานบนโต๊ะช่าง"@th ;
 skos:prefLabel "Bench plane"@en ;
 skos:definition "กบสำหรับงานไสทั่วไปบนโต๊ะช่างตามการแบ่งกลุ่มเครื่องมือ"@th ;
 skos:scopeNote "ไม่ใช่กบทุกชนิด"@th .

<urn:noppadol:assets:concept:smoothing-plane> a skos:Concept ;
