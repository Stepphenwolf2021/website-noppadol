---
layout: layouts/atlas.njk
pagination:
  data: atlas.topics
  size: 1
  alias: topic
permalink: "{{ topic.url }}"
eleventyComputed:
  title: "{{ topic.label }}"
  description: "{{ topic.description }}"
---
<div class="topic-layout"><section class="editorial"><header class="topic-heading topic-intro"><div class="topic-intro-copy"><h1 lang="en">{{ topic.label }}</h1><p class="thai-title">{{ topic.th }}</p><p class="deck">{{ topic.description }}</p></div><figure class="topic-art"><img src="{{ topicArtwork[topic.id].url }}" alt="{{ topicArtwork[topic.id].alt }}" width="{{ topicArtwork[topic.id].width }}" height="{{ topicArtwork[topic.id].height }}" decoding="async"></figure></header>
{% set found = false %}
{% for a in atlas.articles %}{% if topic.domain and a.domain == topic.domain %}{% set found = true %}<article class="{{ 'lead-story' if a.domain == 'woodworking' else 'text-story' }}">{% if a.domain == 'woodworking' %}<a class="story-art" href="{{ a.url }}"><img src="/assets/atlas/{{ 'woodworking' if a.domain == 'woodworking' else 'seize-the-day' }}.webp" width="900" height="600" alt="{{ 'ภาพประกอบกบไสไม้และขี้กบ' if a.domain == 'woodworking' else 'ภาพประกอบช่วงเวลาสำหรับการฟังและคิด' }}"></a>{% endif %}<div><p class="eyebrow">บันทึก</p><h2><a href="{{ a.url }}">{{ a.title }}</a></h2><p>{{ a.subtitle }}</p><a class="read-link" href="{{ a.url }}">อ่านเรื่องนี้ →</a><div class="concept-links">{% for c in a.concepts %}<a href="{{ c.url }}">{{ c.label }}</a>{% endfor %}</div></div></article>{% endif %}{% endfor %}
{% for a in collections.articles %}{% if a.data.department in (topic.legacy | atlasDepartments) %}{% set found = true %}<article class="text-story"><p class="eyebrow">บทความ</p><h2><a href="{{ a.url }}">{{ a.data.title }}</a></h2><p>{{ a.data.subtitle }}</p><a class="read-link" href="{{ a.url }}">อ่านเรื่องนี้ →</a></article>{% endif %}{% endfor %}
{% if not found %}<div class="empty-state"><span class="empty-mark" aria-hidden="true">○</span><h2>พื้นที่สำหรับเรื่องที่กำลังจะเติบโต</h2><p>หมวดนี้ยังไม่มีบทความที่เผยแพร่ เลือกสำรวจความสนใจอื่นในแผนที่ได้</p><a class="read-link" href="/">กลับไปสำรวจแผนที่ →</a></div>{% endif %}
{% if topic.domain %}<section class="vocabulary"><h2>คำที่ชวนให้ค้นต่อ</h2><div class="concept-links">{% for c in atlas.concepts %}{% if topic.domain in c.domains %}<a href="{{ c.url }}">{{ c.label }}</a>{% endif %}{% endfor %}</div></section>{% endif %}
</section><aside class="context"><h2 class="eyebrow" lang="en">my place in the universe</h2><nav class="local-map" aria-label="ตำแหน่งในแผนที่ความสนใจ"><a class="map-root" href="/">seize the day universe</a><span class="map-trunk" aria-hidden="true"></span><span class="map-current" aria-current="page"><i aria-hidden="true"></i>{{ topic.label }}<small>{{ topic.th }}</small></span>{% for a in atlas.articles %}{% if topic.domain and a.domain == topic.domain %}<div class="map-branches" aria-label="แนวคิดจากบทความในหมวด">{% for c in a.concepts %}{% if loop.index <= 2 %}<a href="{{ c.url }}"><i aria-hidden="true"></i>{{ c.graphLabel | lower }}<small>{{ c.label }}</small></a>{% endif %}{% endfor %}</div>{% endif %}{% endfor %}<span class="map-trunk" aria-hidden="true"></span><a class="map-bottom" href="/atlas/">mission-driven ontology</a></nav><section class="neighbor-links"><h2>สำรวจเรื่องอื่น</h2>{% for t in atlas.topics %}{% if t.id != topic.id %}<a href="{{ t.url }}"><span>{{ t.label }}</span><small>{{ t.th }}</small><span aria-hidden="true">↗</span></a>{% endif %}{% endfor %}</section><p class="context-note">เส้นในแผนที่แสดงการอยู่ในหมวดเดียวกัน ส่วนความเชื่อมโยงของบทความอ้างตามคำที่ระบุในเนื้อหา</p></aside></div>
