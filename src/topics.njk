---
layout: layouts/atlas.njk
pagination:
  data: atlas.topics
  size: 1
  alias: topic
permalink: "{{ topic.url }}"
eleventyComputed:
  title: "{{ topic.label }}"
  description: "{{ topic.description }}"
---
<div class="topic-layout category-layout"><section class="editorial"><header class="topic-heading topic-intro"><div class="topic-intro-copy"><h1 lang="en" data-content-key="category.title.en">{{ topic.label }}</h1><p class="thai-title" data-content-key="category.title.th">{{ topic.th }}</p><p class="deck" data-content-key="category.description">{{ topic.description }}</p></div><figure class="topic-art" data-content-key="category.visual"><img src="{{ topicArtwork[topic.id].url }}" alt="{{ topicArtwork[topic.id].alt }}" width="{{ topicArtwork[topic.id].width }}" height="{{ topicArtwork[topic.id].height }}" decoding="async"></figure></header>
{% set articleCount = 0 %}
{% for a in atlas.articles %}{% if a | articleInTopic(topic) %}{% set articleCount = articleCount + 1 %}{% endif %}{% endfor %}
{% for a in collections.articles %}{% if a.data.department in (topic.legacy | atlasDepartments) %}{% set articleCount = articleCount + 1 %}{% endif %}{% endfor %}
<section class="category-content" aria-labelledby="category-content-title"><div class="section-heading"><h2 id="category-content-title" data-content-key="content.heading">บันทึกในหมวดนี้</h2><span data-content-key="content.count">{{ articleCount }} เรื่อง</span></div>
{% set found = false %}
{% for a in atlas.articles %}{% if a | articleInTopic(topic) %}{% set found = true %}<article class="text-story category-story"><div><p class="eyebrow" data-content-key="article.type">บันทึก</p><h2 data-content-key="article.title"><a href="{{ a.url }}">{{ a.title }}</a></h2><p data-content-key="article.summary">{{ a.subtitle }}</p><a class="read-link" data-content-key="article.read" href="{{ a.url }}">อ่านเรื่องนี้ต่อ</a><div class="concept-links" data-content-key="concept.links">{% for c in a.concepts %}<a href="{{ c.url }}">{{ c.label }}</a>{% endfor %}</div></div></article>{% endif %}{% endfor %}
{% for a in collections.articles %}{% if a.data.department in (topic.legacy | atlasDepartments) %}{% set found = true %}<article class="text-story category-story"><p class="eyebrow" data-content-key="article.type">บทความ</p><h2 data-content-key="article.title"><a href="{{ a.url }}">{{ a.data.title }}</a></h2><p data-content-key="article.summary">{{ a.data.subtitle }}</p><a class="read-link" data-content-key="article.read" href="{{ a.url }}">อ่านเรื่องนี้ต่อ</a></article>{% endif %}{% endfor %}
{% if not found %}<div class="empty-state"><h3 data-content-key="empty.title">เรื่องราวจะค่อย ๆ เพิ่มขึ้นที่นี่</h3><p data-content-key="empty.description">หมวดนี้ยังไม่มีบทความที่เผยแพร่ เลือกสำรวจความสนใจอื่นในแผนที่ได้</p><a class="read-link" href="/">กลับไปสำรวจแผนที่ →</a></div>{% endif %}
</section>
{% if topic.domain %}<section class="vocabulary"><h2 data-content-key="concept.heading">คำที่ชวนให้ค้นต่อ</h2><div class="concept-links" data-content-key="concept.links">{% for c in atlas.concepts %}{% if topic.domain in c.domains %}<a href="{{ c.url }}">{{ c.label }}</a>{% endif %}{% endfor %}</div></section>{% endif %}
</section><aside class="context"><h2 class="eyebrow" lang="en" data-content-key="sidebar.heading">my place in the universe</h2><nav class="local-map" aria-label="ตำแหน่งในแผนที่ความสนใจ"><a data-content-key="map.root" class="map-root" href="/">seize the day universe</a><span class="map-trunk" aria-hidden="true"></span><span data-content-key="map.current" class="map-current" aria-current="page"><i aria-hidden="true"></i>{{ topic.label }}<small>{{ topic.th }}</small></span>{% for a in atlas.articles %}{% if a | articleInTopic(topic) %}<div class="map-branches" aria-label="แนวคิดจากบทความในหมวด">{% for c in a.concepts %}{% if loop.index <= 2 %}<a href="{{ c.url }}"><i aria-hidden="true"></i>{{ c.graphLabel | lower }}<small>{{ c.label }}</small></a>{% endif %}{% endfor %}</div>{% endif %}{% endfor %}<span class="map-trunk" aria-hidden="true"></span><a data-content-key="map.foundation" class="map-bottom" href="/atlas/">mission-driven ontology</a></nav><section class="neighbor-links"><h2 data-content-key="related.heading">สำรวจเรื่องอื่นๆ</h2>{% for t in atlas.topics %}{% if t.id != topic.id %}<a data-content-key="related.topic" href="{{ t.url }}"><span>{{ t.label }}</span><small>{{ t.th }}</small><span aria-hidden="true">↗</span></a>{% endif %}{% endfor %}</section><p class="context-note" data-content-key="sidebar.note">เส้นในแผนที่แสดงการอยู่ในหมวดเดียวกัน ส่วนความเชื่อมโยงของบทความอ้างตามคำที่ระบุในเนื้อหา</p></aside></div>
