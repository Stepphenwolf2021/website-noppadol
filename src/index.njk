<p class="translation" lang="en">i doubt, therefore i am not alone.</p>
<nav class="universe" aria-label="เลือกหมวดความสนใจ">
<svg class="connections" aria-hidden="true">{% for t in atlas.topics %}<line x1="{{ t.x }}%" y1="{{ t.y }}%" x2="50%" y2="52%"/>{% endfor %}</svg>
{% for t in atlas.topics %}<a class="topic-orbit {{ t.id }}" href="{{ t.url }}" aria-label="{{ t.label }} {{ t.th }} — ดูตัวอย่างคำและโครงสร้าง ontology" style="--x:{{ t.x }}%;--y:{{ t.y }}%"><svg class="ontology-halo" viewBox="0 0 360 360" aria-hidden="true" focusable="false"><defs>{% for ring in t.hints %}<path id="halo-{{ t.id }}-{{ loop.index }}" d="M 180,180 m -{{ ring.radius }},0 a {{ ring.radius }},{{ ring.radius }} 0 1,1 {{ ring.radius * 2 }},0 a {{ ring.radius }},{{ ring.radius }} 0 1,1 -{{ ring.radius * 2 }},0"/>{% endfor %}</defs>{% for ring in t.hints %}<circle cx="180" cy="180" r="{{ ring.radius }}"/><text><textPath href="#halo-{{ t.id }}-{{ loop.index }}" startOffset="9%">{{ ring.text }}</textPath></text>{% endfor %}</svg><span class="topic-name">{{ t.label | replace(".", ".<wbr>") | safe }}</span><span class="topic-th">{{ t.th }}</span></a>{% endfor %}
<div class="universe-center"><h1 class="universe-name" lang="en">seize the day<br>universe</h1><a class="portrait" href="/atlas/" aria-label="สำรวจโครงสร้าง seize the day universe"><img src="{{ atlas.portrait }}" width="900" height="900" alt="นพดลนั่งจิบกาแฟบนเก้าอี้ seize the day"></a><p class="welcome" lang="en">welcome to<br>my second brain</p></div>
</nav>
{% for a in atlas.articles %}{% if a.id == "the-foundation-01" %}
<section class="home-feature" aria-labelledby="home-feature-title"><div class="home-feature-copy"><p class="eyebrow">บันทึกเบื้องหลังจักรวาลความรู้</p><h2 id="home-feature-title"><a href="{{ a.url }}">{{ a.title }}</a></h2><p class="home-feature-deck">{{ a.subtitle }}</p><div class="home-feature-excerpt">{{ a.body | articleOpening | safe }}</div><a class="read-link" href="{{ a.url }}">อ่านเรื่องนี้ต่อ →</a></div><a class="home-feature-image" href="{{ a.url }}" aria-label="อ่าน The foundation ตอนที่ 1"><img src="{{ a.image }}" width="1774" height="887" loading="lazy" alt="จักรวาลความรู้ส่วนตัวและขั้นตอนผลิตเนื้อหาที่ผู้เขียนเขียนเอง มี AI ช่วยวิเคราะห์ตรวจทาน"></a></section>
{% endif %}{% endfor %}
