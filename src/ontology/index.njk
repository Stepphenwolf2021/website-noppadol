<section class="hero"><p class="eyebrow">Ontology Pipeline / งานไม้และแผ่นเสียง</p><h1>ความรู้ที่เชื่อมกัน</h1><p class="lead">คำที่ใช้เรียกสิ่งต่างๆ และโครงสร้างที่ช่วยแยกข้อมูลให้ชัด</p><p><a href="/studio/">เปิด Studio เพื่อจัดการคำศัพท์และสร้างไฟล์ →</a></p></section>
<section class="section"><h2>จากวัตถุดิบไปถึงเรื่องที่อ่าน</h2><ol class="pipeline"><li>คำศัพท์</li><li>แบบข้อมูล</li><li>หมวดหมู่</li><li>คำและความสัมพันธ์</li><li>แบบจำลอง</li><li>กราฟความรู้</li></ol><p>ใช้กรอบนี้จัดข้อมูลทั้งสองหมวด และเก็บที่มาของเนื้อหาไว้สำหรับตรวจทาน</p></section>
<section class="section"><h2>แผนผังแบบจำลอง</h2><p>เลือกเส้นเชื่อมเพื่ออ่านความหมาย แผนผังนี้แสดงชนิดของข้อมูล ไม่ใช่ทะเบียนทรัพย์สิน</p><div class="model"><svg id="model" viewBox="0 0 900 520" role="img" aria-label="แบบจำลองความสัมพันธ์ของบันทึกต้นทาง ข้อสังเกต รุ่นผลิตภัณฑ์ ฉบับวางจำหน่าย และต้นฉบับเนื้อหา"></svg></div><div id="model-detail" class="note" aria-live="polite">SourceRecord แยกจาก AssetItem และ ReleaseEdition เพื่อรักษาความหมายของแต่ละรายการ</div></section>
{% for domain in semantic.domains %}<section class="section" id="{{ domain.id }}"><h2>ความสัมพันธ์ในหมวด{{ domain.label }}</h2><div class="relation-grid">{% for c in semantic.concepts %}{% if domain.id in c.domains and (c.narrower | length or domain.id == 'vinyl') %}<div class="relation-card"><h3><a href="{{ c.url }}">{{ c.label }}</a></h3>{% if c.narrower | length %}<p class="eyebrow">แบ่งเป็นชนิด</p><ul>{% for id in c.narrower %}{% set child = id | conceptById %}<li><a href="{{ child.url }}">{{ child.label }}</a></li>{% endfor %}</ul>{% else %}<p class="eyebrow">อ่านเรื่องที่เกี่ยวข้อง</p><ul>{% for id in c.related %}{% set child = id | conceptById %}<li><a href="{{ child.url }}">{{ child.label }}</a></li>{% endfor %}</ul>{% endif %}</div>{% endif %}{% endfor %}</div><a href="{{ '/woodworking/' if domain.id == 'woodworking' else '/records/' }}">อ่านหมวด{{ domain.label }} →</a></section>{% endfor %}
<section class="section"><h2>ไฟล์สำหรับนำความรู้ไปใช้ต่อ</h2><div class="chips"><a href="/ontology/domains/vocabulary.jsonld">คำศัพท์ JSON-LD</a><a href="/ontology/domains/vocabulary.ttl">คำศัพท์ Turtle</a><a href="/ontology/domains/ontology.ttl">แบบจำลอง</a><a href="/ontology/domains/shapes.ttl">กฎตรวจข้อมูล</a><a href="/ontology/domains/metadata-profile.json">แบบข้อมูล</a><a href="/knowledge-graph.jsonld">กราฟเว็บไซต์</a></div><p class="note">รุ่น {{ semantic.version }} · นิยามและความสัมพันธ์เป็นนิยามใช้งานของโครงการ ข้อมูลส่วนตัวและข้อเสนอจับคู่รุ่นแผ่นเสียงอยู่หลังบ้าน</p></section>
<script id="model-data" type="application/json">{{ semantic.model | safeJson | safe }}</script><script src="/assets/js/domain-model.js" defer></script>
